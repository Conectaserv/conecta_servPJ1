# Copie para: /etc/systemd/system/conectaserv.service
# Depois: sudo systemctl daemon-reload && sudo systemctl enable --now conectaserv

[Unit]
Description=ConectaServ Flask (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/conectaserv
EnvironmentFile=/var/www/conectaserv/.env
ExecStart=/var/www/conectaserv/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
