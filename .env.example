# Copie para .env no servidor de produção (Hostinger VPS)

# Obrigatório em produção (senão sessões resetam a cada reinício)
SECRET_KEY=sua_chave_secreta_longa_aqui
FLASK_ENV=production

# Render com disco persistente (Settings -> Disks -> mount /var/data)
# DATABASE_PATH=/var/data/conecta_serv.db

# E-mail (opcional em desenvolvimento — sem isso, e-mails aparecem no console)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha
SMTP_FROM=noreply@seudominio.com
SMTP_TLS=1
